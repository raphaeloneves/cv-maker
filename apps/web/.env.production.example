# Copy to .env.production (gitignored) before running `pnpm run deploy`,
# or export PUBLIC_API_BASE_URL in your CI environment instead — either
# is picked up by Astro's build (Vite loads .env.production in "production"
# mode, which `astro build` always uses).
#
# This is a client-exposed build-time value (Astro only inlines PUBLIC_-
# prefixed vars), baked into the static output — not a secret, but it must
# point at your deployed apps/api instance, not localhost.
PUBLIC_API_BASE_URL=https://api.yourdomain.com
