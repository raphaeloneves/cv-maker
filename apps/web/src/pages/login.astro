---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { LoginForm } from "@/domains/auth/components/LoginForm";
import { t } from "@/i18n";
import { DEFAULT_LOCALE } from "@/lib/locale";
const locale = DEFAULT_LOCALE;
---

<BaseLayout title="Log in" surface="light" showFooter={false}>
  <div class="grid min-h-[calc(100vh-57px)] lg:grid-cols-2">
    <div data-surface="dark" class="hidden flex-col justify-between bg-navy-deep px-12 py-14 lg:flex">
      <a href="/" class="flex items-baseline gap-1.5 font-display text-xl font-extrabold tracking-tight text-white">
        <span>CV</span><span class="text-orange">Maker</span>
      </a>
      <div>
        <p class="eyebrow text-xs text-orange" data-i18n="auth.login.eyebrow">{t(locale, "auth.login.eyebrow")}</p>
        <h2 class="mt-3 max-w-sm font-display text-3xl font-extrabold leading-tight tracking-tight text-white">
          Pick up right where you left off.
        </h2>
        <p class="mt-3 max-w-sm text-sm text-ice/70">
          Your CVs, sections and template picks are exactly as you left them.
        </p>
      </div>
      <p class="text-xs text-muted">
        CV Maker, by <a href="https://flathire.agency" target="_blank" rel="noopener noreferrer" class="text-orange hover:text-accent-hover">Flathire</a>
      </p>
    </div>

    <div class="flex items-center justify-center px-5 py-16 sm:px-8">
      <div class="w-full max-w-sm">
        <p class="eyebrow text-xs text-orange lg:hidden" data-i18n="auth.login.eyebrow">{t(locale, "auth.login.eyebrow")}</p>
        <h1 class="mt-2 font-display text-2xl font-extrabold tracking-tight text-heading" data-i18n="auth.login.title">
          {t(locale, "auth.login.title")}
        </h1>

        <div class="mt-6">
          <LoginForm client:load />
        </div>

        <p class="mt-6 text-sm text-text-muted">
          <span data-i18n="auth.login.noAccount">{t(locale, "auth.login.noAccount")}</span>
          <a href="/signup" data-i18n="auth.login.signUpLink" class="font-semibold text-orange hover:text-accent-hover">
            {t(locale, "auth.login.signUpLink")}
          </a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
