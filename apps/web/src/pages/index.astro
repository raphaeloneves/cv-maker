      <div class="mt-6 flex items-center justify-center gap-4">
        <button
          type="button"
          id="testimonial-prev"
          aria-label="Previous testimonial"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border-on-light)] text-heading transition-colors duration-fast ease-standard hover:bg-surface-sunken"
        >
          <span set:html={icon("arrow", "currentColor", 16)} style="transform: rotate(180deg); display: inline-flex;" />
        </button>
        <div id="testimonial-dots" class="flex items-center gap-2">
          {
            testimonialPages.map((_, i) => (
              <button
                type="button"
                data-index={i}
                aria-label={`Go to testimonials page ${i + 1}`}
                class="testimonial-dot h-1.5 w-1.5 rounded-full bg-[var(--border-on-light)] transition-transform duration-fast ease-standard"
              />
            ))
          }
        </div>
        <button
          type="button"
          id="testimonial-next"
          aria-label="Next testimonial"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border-on-light)] text-heading transition-colors duration-fast ease-standard hover:bg-surface-sunken"
        >
          <span set:html={icon("arrow", "currentColor", 16)} style="display: inline-flex;" />
        </button>
      </div>
    </div>

    <script>
      const track = document.getElementById("testimonial-track");
      const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".testimonial-dot"));
      const prevBtn = document.getElementById("testimonial-prev");
      const nextBtn = document.getElementById("testimonial-next");
      if (track && dots.length) {
        const cardWidth = () => track!.children[0]?.getBoundingClientRect().width ?? 0;
        const gap = 24;

        function activeIndex() {
          const scrollLeft = track!.scrollLeft;
          return Math.round(scrollLeft / (cardWidth() + gap));
        }
        function paintDots() {
          const active = activeIndex();
          dots.forEach((dot, i) => {
            dot.classList.toggle("bg-orange", i === active);
            dot.classList.toggle("scale-150", i === active);
            dot.classList.toggle("bg-[var(--border-on-light)]", i !== active);
          });
        }
        function scrollToIndex(i: number) {
          const clamped = Math.max(0, Math.min(dots.length - 1, i));
          track!.scrollTo({ left: clamped * (cardWidth() + gap), behavior: "smooth" });
        }

        dots.forEach((dot, i) => dot.addEventListener("click", () => scrollToIndex(i)));
        prevBtn?.addEventListener("click", () => scrollToIndex(activeIndex() - 1));
        nextBtn?.addEventListener("click", () => scrollToIndex(activeIndex() + 1));
        track.addEventListener("scroll", () => window.requestAnimationFrame(paintDots), { passive: true });
        paintDots();

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduceMotion) {
          let timer: ReturnType<typeof setInterval> | undefined;
          const start = () => {
            timer = setInterval(() => scrollToIndex((activeIndex() + 1) % dots.length), 6000);
          };
          const stop = () => timer && clearInterval(timer);
          start();
          track.addEventListener("pointerenter", stop);
          track.addEventListener("pointerleave", start);
          track.addEventListener("focusin", stop);
          track.addEventListener("focusout", start);
        }
      }
    </script>
