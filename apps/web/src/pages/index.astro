---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Build a CV that gets you hired" surface="dark">
  <main class="min-h-screen flex flex-col items-center justify-center text-center px-6 gap-4">
    <p class="eyebrow text-orange text-sm">CV Maker — by Flathire</p>
    <h1 class="font-display text-5xl font-extrabold tracking-tighter text-white max-w-2xl">
      Build a CV that gets you hired
    </h1>
    <p class="text-ice/80 max-w-lg">
      PLACEHOLDER landing page — real marketing content, hero, pricing and
      the full builder flow land here per the approved build plan.
    </p>
    <a
      href="/builder/personal-info"
      class="mt-4 inline-flex items-center rounded-md bg-orange px-6 py-3 font-semibold text-white transition-colors duration-fast hover:bg-accent-hover"
    >
      Start building — it's free
    </a>
  </main>
</BaseLayout>
