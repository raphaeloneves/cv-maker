                      <div class="mt-6 flex items-center gap-3 border-t border-[var(--border-on-light)] pt-5">
                        {/* PHOTO PLACEHOLDER — replace this initials bubble with:
                            <img src={`/images/marketing/testimonials/${tItem.key}.jpg`} alt="" class="h-11 w-11 rounded-full object-cover" />
                            A square, real headshot of this person, ~200x200px. */}
                        <div
                          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full font-display text-sm font-bold text-white"
                          style={`background:${tItem.color}`}
                        >
                          {tItem.initials}
                        </div>
                        <div>
                          <p class="text-sm font-semibold text-heading">{tItem.name}</p>
                          <p class="text-xs text-text-muted" data-i18n={`marketing.testimonials.${tItem.key}.role`}>
