---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n";
import { DEFAULT_LOCALE } from "@/lib/locale";
const locale = DEFAULT_LOCALE;

// ---------------------------------------------------------------------------
// Content-driving data. Kept as small local arrays/maps (same pattern the
// previous version of this page used) rather than new components, since a
// one-page marketing site is a single reading experience, not a set of
// reusable domain widgets.
// ---------------------------------------------------------------------------

const painRows = ["row1", "row2", "row3", "row4", "row5"] as const;

const frameworkSteps = ["step1", "step2", "step3", "step4"] as const;

const basicFeatures = [
  { key: "autosave", icon: "save" },
  { key: "templates", icon: "layout" },
  { key: "photoEditor", icon: "crop" },
  { key: "printControl", icon: "sliders" },
  { key: "honest", icon: "route" },
  { key: "export", icon: "download" },
] as const;

const freeFeatures = ["cvs", "sections", "templates", "export", "autosave"] as const;
const proFeatures = ["everything", "optimizer", "guide", "watermark", "templates", "cancel"] as const;
const faqs = ["q1", "q2", "q3", "q4"] as const;

const testimonials = [
  { key: "t1", name: "Marta Silva", initials: "MS", rating: 5, color: "#E8640C" },
  { key: "t2", name: "Daniel Cross", initials: "DC", rating: 5, color: "#1B3A6B" },
  { key: "t3", name: "Priya Nair", initials: "PN", rating: 4, color: "#F4A261" },
  { key: "t4", name: "Helena Duarte", initials: "HD", rating: 5, color: "#243F72" },
  { key: "t5", name: "Tomás Almeida", initials: "TA", rating: 5, color: "#B8500A" },
  { key: "t6", name: "Rui Ferreira", initials: "RF", rating: 5, color: "#57647A" },
  { key: "t7", name: "Beatriz Costa", initials: "BC", rating: 4, color: "#2E6E6A" },
  { key: "t8", name: "Nuno Pinto", initials: "NP", rating: 5, color: "#7A2E1D" },
  { key: "t9", name: "Sofia Ramos", initials: "SR", rating: 5, color: "#12403F" },
] as const;

// Grouped into full-width carousel "pages" rather than one dot per card —
// with 2-3 cards peeking into view at once at wider viewports, individual
// per-card scroll targets ran out of scrollable width near the end (the
// browser just clamped, so the last couple of dots silently did nothing).
// A page is always exactly one viewport wide, so there's always exactly one
// scroll position per dot, at every breakpoint. Three even pages of three.
const testimonialPages = [
  [testimonials[0], testimonials[1], testimonials[2]],
  [testimonials[3], testimonials[4], testimonials[5]],
  [testimonials[6], testimonials[7], testimonials[8]],
] as const;

function stars(rating: number) {
  return Array.from({ length: 5 }, (_, i) => i < rating);
}

const ICONS: Record<string, string> = {
  save: '<path d="M5 4h11l3 3v13H5V4Z"/><path d="M8 4v5h8V4"/><path d="M8 20v-6h8v6"/>',
  layout: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 10h16"/><path d="M10 10v10"/>',
  user: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.87 3.13-6 7-6s7 2.13 7 6"/>',
  globe: '<circle cx="12" cy="12" r="8"/><path d="M4 12h16"/><path d="M12 4c2.5 2.5 2.5 13.5 0 16M12 4c-2.5 2.5-2.5 13.5 0 16"/>',
  route: '<circle cx="6" cy="6" r="2.2"/><circle cx="18" cy="18" r="2.2"/><path d="M6 8.2V13a4 4 0 0 0 4 4h3.5"/>',
  panel: '<circle cx="9" cy="10" r="5"/><circle cx="15" cy="10" r="5"/><circle cx="12" cy="16" r="5"/>',
  crop: '<path d="M6 3v13a2 2 0 0 0 2 2h13"/><path d="M18 21V8a2 2 0 0 0-2-2H3"/>',
  sliders: '<path d="M4 7h10M18 7h2"/><circle cx="16" cy="7" r="2"/><path d="M4 17h2M10 17h10"/><circle cx="8" cy="17" r="2"/>',
  download: '<path d="M12 4v11"/><path d="M7 10l5 5 5-5"/><path d="M5 19h14"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  x: '<path d="M18 6 6 18M6 6l12 12"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
};

function icon(name: string, color = "var(--orange)", size = 20) {
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;
}

const STAR_PATH =
  "M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.8-6.2 3.8 1.6-7-5.4-4.7 7.1-.6L12 2.5Z";
function starIcon(filled: boolean) {
  const color = filled ? "var(--orange-warm)" : "#d8dee8";
  return `<svg width="16" height="16" viewBox="0 0 24 24" fill="${filled ? color : "none"}" stroke="${color}" stroke-width="1.5" aria-hidden="true"><path d="${STAR_PATH}"/></svg>`;
}

// ---------------------------------------------------------------------------
// Structured data. FAQPage mirrors the FAQ accordion rendered below it
// verbatim (real, visible copy — required for FAQ rich results). The
// testimonials above are placeholder design content (see the PHOTO
// PLACEHOLDER comments), so no Review/AggregateRating schema is added for
// them — fabricated review markup violates Google's structured data
// guidelines; add it once real testimonials replace the placeholders.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((key) => ({
    "@type": "Question",
    name: t(locale, `pricing.faq.${key}`),
    acceptedAnswer: { "@type": "Answer", text: t(locale, `pricing.faq.a${key.slice(1)}`) },
  })),
};

// priceCurrency assumes USD to match the "$" shown in the pricing section
// below — confirm against the actual Stripe price object's currency before
// relying on this for merchant/rich-result surfaces.
const softwareAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "CV Maker",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description: t(locale, "marketing.hero.subtitle"),
  offers: [
    { "@type": "Offer", name: "Free", price: "0", priceCurrency: "USD" },
    { "@type": "Offer", name: "Pro", price: "8.99", priceCurrency: "USD" },
  ],
};
---

<BaseLayout
  title="Turn your CV into an interview magnet"
  description="Build your CV with the same framework career coaches use, then get an honest AI report scoring it against six real recruiter objections."
  surface="dark"
  jsonLd={[faqJsonLd, softwareAppJsonLd]}
>
  <!-- ============================= HERO ============================= -->
  <section id="hero" class="relative overflow-hidden px-5 pb-24 pt-16 sm:px-8 sm:pb-32 sm:pt-20">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image: radial-gradient(var(--ice) 1px, transparent 1px); background-size: 22px 22px;"
      aria-hidden="true"
    >
    </div>
    <div
      data-animate="drift"
      class="pointer-events-none absolute -right-32 -top-32 h-[560px] w-[560px] rounded-full opacity-25 blur-3xl"
      style="background: radial-gradient(circle, var(--orange) 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div
      data-animate="drift"
      style="animation-delay: -7s; background: radial-gradient(circle, var(--orange-warm) 0%, transparent 70%);"
      class="pointer-events-none absolute -bottom-40 -left-24 h-[420px] w-[420px] rounded-full opacity-20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      data-animate="drift"
      style="animation-delay: -14s; background: radial-gradient(circle, var(--navy-light) 0%, transparent 70%);"
      class="pointer-events-none absolute left-1/3 top-1/4 h-[380px] w-[380px] rounded-full opacity-40 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="min-w-0">
        <p class="eyebrow text-xs text-orange" data-i18n="marketing.eyebrow">{t(locale, "marketing.eyebrow")}</p>
        <h1 class="mt-4 max-w-xl font-display text-4xl font-extrabold leading-[1.05] tracking-tighter text-white sm:text-5xl lg:text-[3.4rem]">
          <span data-i18n="marketing.hero.title.prefix">{t(locale, "marketing.hero.title.prefix")}</span>{" "}
          <span class="text-gradient-shimmer" data-i18n="marketing.hero.title.accent">
            {t(locale, "marketing.hero.title.accent")}
          </span>
        </h1>
        <p class="mt-5 max-w-md text-base leading-relaxed text-ice/75" data-i18n="marketing.hero.subtitle">
          {t(locale, "marketing.hero.subtitle")}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/signup"
            data-i18n="marketing.hero.cta.primary"
            class="inline-flex items-center rounded-md bg-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-orange/0 transition-all duration-standard ease-standard hover:-translate-y-0.5 hover:bg-accent-hover hover:shadow-orange/30"
          >
            {t(locale, "marketing.hero.cta.primary")}
          </a>
          <a
            href="#framework"
            data-i18n="marketing.hero.cta.secondary"
            class="inline-flex items-center rounded-md border border-[var(--border-on-dark)] px-6 py-3 text-sm font-semibold text-ice transition-all duration-standard ease-standard hover:-translate-y-0.5 hover:border-orange/40 hover:bg-navy-mid"
          >
            {t(locale, "marketing.hero.cta.secondary")}
          </a>
        </div>

      </div>

      <!-- Signature element: an animated frame around a screenshot of the
           actual CV Optimizer report, with the real product's verdict stamp
           and score gauge (see VerdictStamp.tsx / ScoreGauge.tsx) recreated
           floating on top of it. The screenshot itself is a placeholder —
           see the instructions in the comment below the frame. -->
      <div class="relative mx-auto w-full min-w-0 max-w-xl" data-animate="fade-up">
        <div data-animate="float" class="relative rounded-lg bg-white p-2.5 shadow-2xl shadow-black/40" style="transform: rotate(-1.5deg);">
          <div class="flex items-center gap-1.5 px-2 pb-2 pt-1">
            <span class="h-2.5 w-2.5 rounded-full bg-[#e0e4ea]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#e0e4ea]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#e0e4ea]"></span>
            <span class="mono-label ml-2 text-[9px] text-[#9aa5ba]" data-i18n="marketing.hero.screenshot.badge">
              {t(locale, "marketing.hero.screenshot.badge")}
            </span>
          </div>
          <!--
            SCREENSHOT PLACEHOLDER — replace this div with:
              <img src="/images/marketing/optimizer-report-hero.png" alt="" class="aspect-[4/3] w-full rounded-b-md object-cover object-top" />
            Capture: open a completed CV Optimizer report (/optimizer/[id]),
            screenshot the top of the page (verdict stamp + score gauge +
            role title), landscape crop, ~1200x900px, save as
            optimizer-report-hero.png in apps/web/public/images/marketing/.
          -->
          <div
            class="flex aspect-[4/3] w-full flex-col items-center justify-center gap-2 rounded-b-md border border-dashed border-[var(--border-on-light)]"
            style="background-image: repeating-linear-gradient(135deg, var(--surface-sunken) 0, var(--surface-sunken) 1px, transparent 1px, transparent 12px); background-color: var(--surface-page);"
          >
            <span set:html={icon("layout", "#9aa5ba", 28)} />
            <p class="mono-label text-center text-[10px] text-[#9aa5ba]">Screenshot placeholder<br />optimizer-report-hero.png</p>
          </div>
        </div>

        <div
          data-animate="float"
          style="animation-delay: -1.8s; transform: rotate(-6deg);"
          class="absolute -bottom-6 -left-8 inline-block rounded-sm border-4 border-success p-1.5 shadow-lg"
        >
          <div class="flex items-center gap-2 rounded-[3px] border-2 border-success bg-navy-deep px-4 py-1.5">
            <span set:html={icon("check", "var(--success)", 18)} />
            <span class="font-display text-lg font-extrabold uppercase tracking-widest text-success">
              {t(locale, "optimizer.detail.verdict.pass")}
            </span>
          </div>
        </div>

        <div
          data-animate="float"
          style="animation-delay: -3s; transform: rotate(-3deg);"
          class="absolute -top-9 left-14 flex items-center gap-2 rounded-pill bg-navy-mid px-4 py-2.5 shadow-lg"
        >
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-orange-warm/20" set:html={icon("check", "var(--orange-warm)", 12)} />
          <span class="whitespace-nowrap text-xs font-semibold text-white" data-i18n="marketing.hero.badge.human">
            {t(locale, "marketing.hero.badge.human")}
          </span>
        </div>

        <div
          data-animate="float"
          style="animation-delay: -5.4s; transform: rotate(6deg);"
          class="absolute -right-10 top-[42%] flex items-center gap-2 rounded-pill bg-navy-mid px-5 py-3 shadow-xl"
        >
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange/20" set:html={icon("check", "var(--orange)", 14)} />
          <span class="whitespace-nowrap text-sm font-semibold text-white" data-i18n="marketing.hero.badge.ai">
            {t(locale, "marketing.hero.badge.ai")}
          </span>
        </div>

        <div
          data-animate="float"
          style="animation-delay: -1.2s; transform: rotate(2deg);"
          class="absolute -bottom-9 right-10 flex items-center gap-2 rounded-pill bg-navy-mid px-4 py-2.5 shadow-lg"
        >
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-success/20" set:html={icon("check", "var(--success)", 12)} />
          <span class="whitespace-nowrap text-xs font-semibold text-white" data-i18n="marketing.hero.badge.ats">
            {t(locale, "marketing.hero.badge.ats")}
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= PAIN ============================= -->
  <section data-surface="light" class="relative overflow-hidden bg-surface-page px-5 py-20 sm:px-8 sm:py-28">
    <div class="mx-auto max-w-3xl text-center" data-animate="fade-up">
      <p class="eyebrow text-xs text-orange" data-i18n="marketing.pain.eyebrow">{t(locale, "marketing.pain.eyebrow")}</p>
      <h2 class="mt-4 font-display text-3xl font-extrabold leading-snug tracking-tight text-heading sm:text-4xl" data-i18n="marketing.pain.title">
        {t(locale, "marketing.pain.title")}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-text-muted" data-i18n="marketing.pain.subtitle">
        {t(locale, "marketing.pain.subtitle")}
      </p>
    </div>

    <div class="mx-auto mt-14 max-w-4xl" data-animate="fade-up">
      <div class="mb-3 hidden grid-cols-[1fr_44px_1fr] gap-3 sm:grid sm:gap-4">
        <div class="flex items-center gap-2 rounded-md bg-surface-sunken px-4 py-2">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#9aa5ba]" />
          <p class="mono-label text-[10px] text-text-muted" data-i18n="marketing.pain.myth.label">{t(locale, "marketing.pain.myth.label")}</p>
        </div>
        <span></span>
        <div class="flex items-center gap-2 rounded-md bg-navy-deep px-4 py-2">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-orange" />
          <p class="mono-label text-[10px] text-orange-warm" data-i18n="marketing.pain.reality.label">{t(locale, "marketing.pain.reality.label")}</p>
        </div>
      </div>

      <div class="flex flex-col gap-3">
        {
          painRows.map((rowKey, i) => (
            <div
              data-animate="fade-up"
              style={`transition-delay:${i * 80}ms`}
              class="group grid grid-cols-1 gap-2 sm:grid-cols-[1fr_44px_1fr] sm:items-stretch sm:gap-4"
            >
              <div class="flex items-start gap-3 rounded-lg border border-[var(--border-on-light)] bg-surface-sunken/70 p-4">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white" set:html={icon("x", "#9aa5ba", 14)} />
                <span class="text-sm text-text-muted line-through decoration-[#b8bfd1]" data-i18n={`marketing.pain.${rowKey}.myth`}>
                  {t(locale, `marketing.pain.${rowKey}.myth`)}
                </span>
              </div>

              <div class="hidden items-center justify-center sm:flex">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-2 border-orange/25 bg-surface-card text-orange shadow-sm transition-transform duration-standard ease-standard group-hover:scale-110 group-hover:border-orange/50">
                  <span set:html={icon("arrow", "var(--orange)", 16)} />
                </span>
              </div>
              <div class="sm:hidden" set:html={icon("arrow", "var(--orange)", 16)} style="transform: rotate(90deg); margin-left: 1.25rem;" />

              <div class="flex items-start gap-3 rounded-lg border-2 border-orange/15 bg-surface-card p-4 shadow-sm transition-all duration-standard ease-standard group-hover:border-orange/40 group-hover:shadow-md">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange/10 text-orange" set:html={icon("check", "var(--orange)", 14)} />
                <span class="text-sm font-semibold text-heading" data-i18n={`marketing.pain.${rowKey}.reality`}>
                  {t(locale, `marketing.pain.${rowKey}.reality`)}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ FRAMEWORK ============================ -->
  <section id="framework" class="scroll-mt-16 relative overflow-hidden px-5 py-20 sm:px-8 sm:py-28">
    <div
      data-animate="drift"
      style="animation-delay: -4s; background: radial-gradient(circle, var(--orange) 0%, transparent 70%);"
      class="pointer-events-none absolute -left-40 top-10 h-[420px] w-[420px] rounded-full opacity-[0.12] blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      data-animate="drift"
      style="animation-delay: -11s; background: radial-gradient(circle, var(--orange-warm) 0%, transparent 70%);"
      class="pointer-events-none absolute -right-32 bottom-0 h-[380px] w-[380px] rounded-full opacity-[0.1] blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-2xl text-center" data-animate="fade-up">
      <p class="eyebrow text-xs text-orange" data-i18n="marketing.framework.eyebrow">{t(locale, "marketing.framework.eyebrow")}</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl" data-i18n="marketing.framework.title">
        {t(locale, "marketing.framework.title")}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-ice/75" data-i18n="marketing.framework.subtitle">
        {t(locale, "marketing.framework.subtitle")}
      </p>
    </div>

    <div class="relative mx-auto mt-16 max-w-6xl">
      <div class="pointer-events-none absolute left-0 right-0 top-6 hidden h-px bg-[var(--border-on-dark)] lg:block" aria-hidden="true"></div>
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {
          frameworkSteps.map((stepKey, i) => (
            <div data-animate="fade-up" style={`transition-delay:${i * 110}ms`} class="group relative flex flex-col gap-3">
              <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full border-2 border-orange bg-navy-deep font-display text-lg font-extrabold text-orange transition-transform duration-standard ease-standard group-hover:scale-110 group-hover:bg-orange group-hover:text-white">
                {String(i + 1).padStart(2, "0")}
              </div>
              <h3 class="font-display text-lg font-bold text-white" data-i18n={`marketing.framework.${stepKey}.title`}>
                {t(locale, `marketing.framework.${stepKey}.title`)}
              </h3>
              <p class="text-sm leading-relaxed text-ice/70" data-i18n={`marketing.framework.${stepKey}.body`}>
                {t(locale, `marketing.framework.${stepKey}.body`)}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14 flex justify-center" data-animate="fade-up">
      <a
        href="/signup"
        data-i18n="marketing.framework.cta"
        class="inline-flex items-center rounded-md bg-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-orange/0 transition-all duration-standard ease-standard hover:-translate-y-0.5 hover:bg-accent-hover hover:shadow-orange/30"
      >
        {t(locale, "marketing.framework.cta")}
      </a>
    </div>
  </section>

  <!-- ============================ OPTIMIZER ============================ -->
  <section id="optimizer" data-surface="light" class="scroll-mt-16 relative overflow-hidden bg-surface-page px-5 py-20 sm:px-8 sm:py-28">
    <div class="relative mx-auto max-w-2xl text-center" data-animate="fade-up">
      <p class="eyebrow text-xs text-orange" data-i18n="marketing.optimizer.eyebrow">{t(locale, "marketing.optimizer.eyebrow")}</p>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-heading sm:text-4xl" data-i18n="marketing.optimizer.title">
        {t(locale, "marketing.optimizer.title")}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-text-muted" data-i18n="marketing.optimizer.subtitle">
        {t(locale, "marketing.optimizer.subtitle")}
      </p>
    </div>

    <!-- Feature row: verdict pitch + report screenshot -->
    <div class="mx-auto mt-16 grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div data-animate="fade-up" class="order-2 lg:order-1">
        <span class="flex h-11 w-11 items-center justify-center rounded-md border border-[var(--border-on-light)]" set:html={icon("check")} />
        <h3 class="mt-4 font-display text-2xl font-bold text-heading" data-i18n="marketing.optimizer.verdict.title">
          {t(locale, "marketing.optimizer.verdict.title")}
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-text-muted" data-i18n="marketing.optimizer.verdict.body">
          {t(locale, "marketing.optimizer.verdict.body")}
        </p>
      </div>
      <div data-animate="fade-up" class="order-1 lg:order-2">
        <div class="rounded-lg border border-[var(--border-on-light)] bg-surface-card p-2.5 shadow-xl shadow-black/5 transition-transform duration-standard ease-standard hover:-translate-y-1">
          <div class="mono-label flex items-center gap-1.5 px-2 pb-2 pt-1 text-[9px] text-text-muted" data-i18n="marketing.optimizer.screenshot.verdict.badge">
            {t(locale, "marketing.optimizer.screenshot.verdict.badge")}
          </div>
          <!--
            SCREENSHOT PLACEHOLDER — replace this div with:
              <img src="/images/marketing/optimizer-report-verdict.png" alt="" class="aspect-[4/3] w-full rounded-b-md object-cover object-top" />
