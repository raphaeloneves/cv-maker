---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n";
import { DEFAULT_LOCALE } from "@/lib/locale";
const locale = DEFAULT_LOCALE;

const features = [
  { key: "autosave", icon: "save" },
  { key: "templates", icon: "layout" },
  { key: "inclusive", icon: "user" },
  { key: "bilingual", icon: "globe" },
  { key: "honest", icon: "route" },
  { key: "export", icon: "download" },
] as const;

const ICONS: Record<string, string> = {
  save: '<path d="M5 4h11l3 3v13H5V4Z"/><path d="M8 4v5h8V4"/><path d="M8 20v-6h8v6"/>',
  layout: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 10h16"/><path d="M10 10v10"/>',
  user: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.87 3.13-6 7-6s7 2.13 7 6"/>',
  globe: '<circle cx="12" cy="12" r="8"/><path d="M4 12h16"/><path d="M12 4c2.5 2.5 2.5 13.5 0 16M12 4c-2.5 2.5-2.5 13.5 0 16"/>',
  route: '<circle cx="6" cy="6" r="2.2"/><circle cx="18" cy="18" r="2.2"/><path d="M6 8.2V13a4 4 0 0 0 4 4h3.5"/>',
  download: '<path d="M12 4v11"/><path d="M7 10l5 5 5-5"/><path d="M5 19h14"/>',
};
---

<BaseLayout
  title="Build a CV that gets you hired"
  description="A fast, guided CV builder with four polished templates, real autosave, and a free watermarked export for everyone."
  surface="dark"
>
  <!-- ============================= HERO ============================= -->
  <section class="relative overflow-hidden px-5 pb-24 pt-16 sm:px-8 sm:pb-32 sm:pt-20">
    <div
      class="pointer-events-none absolute -right-32 -top-32 h-[520px] w-[520px] rounded-full opacity-25 blur-3xl"
      style="background: radial-gradient(circle, var(--orange) 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-16 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <p class="eyebrow text-xs text-orange" data-i18n="marketing.eyebrow">{t(locale, "marketing.eyebrow")}</p>
        <h1
          class="mt-4 max-w-xl font-display text-4xl font-extrabold leading-[1.05] tracking-tighter text-white sm:text-5xl lg:text-[3.4rem]"
          data-i18n="marketing.hero.title"
        >
          {t(locale, "marketing.hero.title")}
        </h1>
        <p class="mt-5 max-w-md text-base leading-relaxed text-ice/75" data-i18n="marketing.hero.subtitle">
          {t(locale, "marketing.hero.subtitle")}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/signup"
            data-i18n="marketing.hero.cta.primary"
            class="inline-flex items-center rounded-md bg-orange px-6 py-3 text-sm font-semibold text-white transition-colors duration-fast ease-standard hover:bg-accent-hover"
          >
            {t(locale, "marketing.hero.cta.primary")}
          </a>
          <a
            href="/pricing"
            data-i18n="marketing.hero.cta.secondary"
            class="inline-flex items-center rounded-md border border-[var(--border-on-dark)] px-6 py-3 text-sm font-semibold text-ice transition-colors duration-fast ease-standard hover:bg-navy-mid"
          >
            {t(locale, "marketing.hero.cta.secondary")}
          </a>
        </div>

        <dl class="mt-12 grid max-w-md grid-cols-3 gap-6 border-t border-[var(--border-on-dark)] pt-6">
          <div>
            <dt class="mono-label text-[10px] text-muted" data-i18n="marketing.hero.stat.templates">
              {t(locale, "marketing.hero.stat.templates")}
            </dt>
            <dd class="mt-1 font-mono text-2xl font-medium text-white">4</dd>
          </div>
          <div>
            <dt class="mono-label text-[10px] text-muted" data-i18n="marketing.hero.stat.languages">
              {t(locale, "marketing.hero.stat.languages")}
            </dt>
            <dd class="mt-1 font-mono text-2xl font-medium text-white">2</dd>
          </div>
          <div>
            <dt class="mono-label text-[10px] text-muted" data-i18n="marketing.hero.stat.free">
              {t(locale, "marketing.hero.stat.free")}
            </dt>
            <dd class="mt-1 font-mono text-2xl font-medium text-white">€0</dd>
          </div>
        </dl>
      </div>

      <!-- Signature element: a miniature live CV mockup built from the
           product's own design tokens (not stock illustration) — a floating
           doc with a "Saved" pill nodding at the real autosave feature. -->
      <div class="relative mx-auto w-full max-w-sm" data-animate="fade-up">
        <div
          data-animate="float"
          class="relative rounded-lg bg-white p-5 shadow-2xl shadow-black/40"
          style="transform: rotate(-2.5deg);"
        >
          <div class="flex items-center gap-3 border-b border-[var(--border-on-light)] pb-3">
            <div class="h-11 w-11 shrink-0 rounded-full bg-navy-mid/15"></div>
            <div class="flex-1">
              <div class="h-2.5 w-28 rounded-full bg-navy-deep/80"></div>
              <div class="mt-1.5 h-2 w-20 rounded-full bg-orange/60"></div>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-[0.8fr_1.4fr] gap-4">
            <div class="flex flex-col gap-2.5">
              <div class="h-1.5 w-14 rounded-full bg-navy-deep/40"></div>
              <div class="h-1.5 w-full rounded-full bg-surface-sunken"></div>
              <div class="h-1.5 w-4/5 rounded-full bg-surface-sunken"></div>
              <div class="mt-2 h-1.5 w-16 rounded-full bg-navy-deep/40"></div>
              <div class="h-1.5 w-full rounded-full bg-surface-sunken"></div>
              <div class="h-1.5 w-3/5 rounded-full bg-surface-sunken"></div>
            </div>
            <div class="flex flex-col gap-2.5">
              <div class="h-1.5 w-24 rounded-full bg-navy-deep/40"></div>
              <div class="h-1.5 w-full rounded-full bg-surface-sunken"></div>
              <div class="h-1.5 w-full rounded-full bg-surface-sunken"></div>
              <div class="h-1.5 w-2/3 rounded-full bg-surface-sunken"></div>
              <div class="mt-2 h-1.5 w-24 rounded-full bg-navy-deep/40"></div>
              <div class="h-1.5 w-full rounded-full bg-surface-sunken"></div>
              <div class="h-1.5 w-4/5 rounded-full bg-surface-sunken"></div>
            </div>
          </div>
        </div>

        <div
          data-animate="float"
          style="animation-delay: -1.8s; transform: rotate(3deg);"
          class="absolute -bottom-5 -left-8 flex items-center gap-2 rounded-pill bg-navy-mid px-3.5 py-2 shadow-lg"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
          <span class="mono-label text-[10px] text-ice">{t(locale, "save.saved")}</span>
        </div>

        <div
          data-animate="float"
          style="animation-delay: -3s; transform: rotate(-4deg);"
          class="absolute -right-6 -top-5 flex gap-1.5 rounded-pill bg-navy-mid px-2.5 py-2 shadow-lg"
        >
          <span class="h-4 w-4 rounded-full" style="background:#E8640C"></span>
          <span class="h-4 w-4 rounded-full" style="background:#1B3A6B"></span>
          <span class="h-4 w-4 rounded-full" style="background:#F4A261"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= TRUST / MANIFESTO ======================= -->
  <section data-surface="light" class="bg-surface-page px-5 py-16 sm:px-8 sm:py-20" data-animate="fade-up">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow text-xs text-orange" data-i18n="marketing.trust.eyebrow">{t(locale, "marketing.trust.eyebrow")}</p>
      <p
        class="mt-4 font-display text-2xl font-bold leading-snug tracking-tight text-heading sm:text-3xl"
        data-i18n="marketing.trust.title"
      >
        {t(locale, "marketing.trust.title")}
      </p>
    </div>
  </section>

  <!-- ============================ FEATURES ============================ -->
  <section data-surface="light" class="bg-surface-page px-5 pb-20 sm:px-8 sm:pb-28">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center" data-animate="fade-up">
        <p class="eyebrow text-xs text-orange" data-i18n="marketing.features.eyebrow">
          {t(locale, "marketing.features.eyebrow")}
        </p>
        <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-heading" data-i18n="marketing.features.title">
          {t(locale, "marketing.features.title")}
        </h2>
      </div>

      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <div data-animate="fade-up" class="flex flex-col gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-md border border-[var(--border-on-light)]" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="1.6" aria-hidden="true">${ICONS[f.icon]}</svg>`} />
              <h3 class="font-display text-base font-bold text-heading" data-i18n={`marketing.features.${f.key}.title`}>
                {t(locale, `marketing.features.${f.key}.title`)}
              </h3>
              <p class="text-sm leading-relaxed text-text-muted" data-i18n={`marketing.features.${f.key}.body`}>
                {t(locale, `marketing.features.${f.key}.body`)}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ FREEMIUM ============================ -->
  <section class="px-5 py-20 sm:px-8 sm:py-28">
    <div class="mx-auto max-w-4xl text-center" data-animate="fade-up">
      <p class="eyebrow text-xs text-orange" data-i18n="marketing.freemium.eyebrow">
        {t(locale, "marketing.freemium.eyebrow")}
      </p>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl" data-i18n="marketing.freemium.title">
        {t(locale, "marketing.freemium.title")}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-ice/75" data-i18n="marketing.freemium.body">
        {t(locale, "marketing.freemium.body")}
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-3xl gap-5 sm:grid-cols-2">
      <div data-animate="fade-up" class="rounded-lg border border-[var(--border-on-dark)] bg-navy-mid p-6">
        <p class="mono-label text-[11px] text-orange-warm" data-i18n="marketing.freemium.free.title">
          {t(locale, "marketing.freemium.free.title")}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-ice/80" data-i18n="marketing.freemium.free.body">
          {t(locale, "marketing.freemium.free.body")}
        </p>
      </div>
      <div data-animate="fade-up" class="rounded-lg border border-orange/40 bg-navy-mid p-6">
        <p class="mono-label text-[11px] text-orange-warm" data-i18n="marketing.freemium.pro.title">
          {t(locale, "marketing.freemium.pro.title")}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-ice/80" data-i18n="marketing.freemium.pro.body">
          {t(locale, "marketing.freemium.pro.body")}
        </p>
      </div>
    </div>

    <div class="mt-8 flex justify-center">
      <a href="/pricing" class="text-sm font-semibold text-orange hover:text-accent-hover">
        {t(locale, "nav.pricing")} →
      </a>
    </div>
  </section>

  <!-- ============================= FINAL CTA ============================= -->
  <section class="border-t border-[var(--border-on-dark)] px-5 py-20 text-center sm:px-8 sm:py-28" data-animate="fade-up">
    <h2 class="mx-auto max-w-xl font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl" data-i18n="marketing.cta.title">
      {t(locale, "marketing.cta.title")}
    </h2>
    <p class="mx-auto mt-3 max-w-md text-sm text-ice/70" data-i18n="marketing.cta.body">{t(locale, "marketing.cta.body")}</p>
    <a
      href="/signup"
      data-i18n="marketing.cta.button"
      class="mt-7 inline-flex items-center rounded-md bg-orange px-7 py-3.5 text-sm font-semibold text-white transition-colors duration-fast ease-standard hover:bg-accent-hover"
    >
      {t(locale, "marketing.cta.button")}
    </a>
  </section>
</BaseLayout>
