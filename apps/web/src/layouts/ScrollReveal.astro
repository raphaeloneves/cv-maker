---
/**
 * Activates every `[data-animate="fade-up"]` element on the page once it
 * scrolls into view (brand doc: "Fade-up on scroll for section entrances...
 * nothing spins, bounces, or calls excess attention to itself"). Included
 * once by `BaseLayout`. Plain IntersectionObserver, no animation library.
 */
---

<script>
  const targets = document.querySelectorAll('[data-animate="fade-up"]');
  if (targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
