---
import { t } from "@/i18n";
import { DEFAULT_LOCALE } from "@/lib/locale";
const locale = DEFAULT_LOCALE;
const year = new Date().getFullYear();
---

<footer data-surface="dark" class="border-t border-[var(--border-on-dark)] bg-navy-deep">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-[1.3fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-baseline gap-1.5 font-display text-lg font-extrabold tracking-tight text-white">
          <span>CV</span><span class="text-orange">Maker</span>
        </a>
        <p data-i18n="footer.tagline" class="mt-3 max-w-xs text-sm text-muted">
          {t(locale, "footer.tagline")}
        </p>
      </div>
      <div>
        <p data-i18n="footer.product" class="eyebrow text-xs text-orange">{t(locale, "footer.product")}</p>
        <ul class="mt-3 space-y-2 text-sm text-ice/80">
          <li><a href="/pricing" data-i18n="nav.pricing" class="hover:text-white">{t(locale, "nav.pricing")}</a></li>
          <li><a href="/signup" data-i18n="nav.startFree" class="hover:text-white">{t(locale, "nav.startFree")}</a></li>
          <li><a href="/dashboard" data-i18n="nav.dashboard" class="hover:text-white">{t(locale, "nav.dashboard")}</a></li>
        </ul>
      </div>
      <div>
        <p data-i18n="footer.legal" class="eyebrow text-xs text-orange">{t(locale, "footer.legal")}</p>
        <ul class="mt-3 space-y-2 text-sm text-ice/80">
          <li><a href="/terms" data-i18n="footer.terms" class="hover:text-white">{t(locale, "footer.terms")}</a></li>
          <li><a href="/privacy" data-i18n="footer.privacy" class="hover:text-white">{t(locale, "footer.privacy")}</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-[var(--border-on-dark)] pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Flathire. <span data-i18n="footer.rights">{t(locale, "footer.rights")}</span></p>
      <p>CV Maker <span data-i18n="brand.by">{t(locale, "brand.by")}</span></p>
    </div>
  </div>
</footer>
