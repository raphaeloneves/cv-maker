---
import "@/styles/global.css";
import SiteNav from "@/components/nav/SiteNav.astro";
import AppNav from "@/components/nav/AppNav.astro";
import SiteFooter from "@/layouts/SiteFooter.astro";
import LocaleHydration from "@/layouts/LocaleHydration.astro";
import ScrollReveal from "@/layouts/ScrollReveal.astro";

interface Props {
  title: string;
  description?: string;
  /** "dark" = brand's dark navy chrome (marketing/nav/footer); "light"
   * (default) = the Ice builder surface used for all form-heavy screens. */
  surface?: "light" | "dark";
  /** Set false only for full-bleed/standalone pages that render their own
   * header (none currently do — kept as an escape hatch). */
  showNav?: boolean;
  /** "marketing" (default) = SiteNav, the funnel chrome shown to visitors
   * and guests (Home, Pricing, log in / start free). "app" = AppNav, the
   * product shell shown once someone has an account (My CVs, CV Optimizer,
   * Billing, Account) — every page behind <RequireAuth> should pass this,
   * since once you're signed in you've left the marketing funnel for good
   * (see the file-level comment on AppNav.astro). */
  nav?: "marketing" | "app";
  /** The builder steps render inside their own focused layout without the
   * marketing footer competing for attention — default true for everything
   * else (marketing pages, auth, dashboard). */
  showFooter?: boolean;
}
const { title, description, surface = "light", showNav = true, nav = "marketing", showFooter = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? "CV Maker. Build a polished CV in minutes, free to start and free to export."} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2220%22 fill=%22%230A1628%22/><text x=%2250%22 y=%2266%22 font-size=%2260%22 text-anchor=%22middle%22 fill=%22%23E8640C%22 font-family=%22sans-serif%22>C</text></svg>" />
    {/* A middot separator, not "{title}, CV Maker" — a comma placed directly
     * after a `{expression}` in Astro template text triggers a parser bug
     * that silently drops the following `<body>` tag's attributes (verified:
     * reproduces in a clean `astro build`, unrelated to dev-server caching).
     * Also sidesteps the "no em dashes" copy rule for what isn't really a
     * sentence anyway. */}
    <title>{title} · CV Maker</title>
  </head>
  <body data-surface={surface}>
    {showNav && (nav === "app" ? <AppNav /> : <SiteNav surface={surface} />)}
    <slot />
    {showFooter && <SiteFooter />}
    <LocaleHydration />
    <ScrollReveal />
  </body>
</html>
