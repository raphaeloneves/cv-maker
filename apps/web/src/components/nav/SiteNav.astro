---
/**
 * Site-wide header nav — every marketing/funnel page (Home, Pricing, login,
 * signup, legal). Always the brand's navy chrome, deliberately not toggled
 * per-page: the nav previously forked light/dark on the page's `surface`,
 * but `bg-navy-deep/95` and `bg-surface-page/90` are Tailwind opacity
 * modifiers applied to theme colors that are just raw `var(--x)` references
 * (see tailwind.config.mjs) — Tailwind can't slot an alpha value into that,
 * so both silently resolved to a fully transparent background-color, with
 * only backdrop-blur left doing anything. Scrolled over a light section,
 * that read as a washed-out, low-contrast nav. Fixed by always painting the
 * nav from `--nav-bg`, a pre-mixed rgba() token (see tokens.css) that
 * doesn't go through that broken pipeline, so the "transparency" is real
 * and constant instead of accidentally zero.
 *
 * Mostly static Astro markup (no React island needed for a nav bar); the
 * only interactivity, the mobile menu disclosure and the builderUiLocale
 * toggle, is handled by a small vanilla script element at the bottom rather
 * than pulling in a React island for a nav bar.
 *
 * Locale: rendered at build time in DEFAULT_LOCALE ("en"); the strings
 * tagged data-i18n are swapped client-side by LocaleHydration.astro
 * (included once by BaseLayout) if the visitor has a stored pt-PT
 * preference — see src/lib/locale.ts for the full explanation.
 *
 * (Note: this comment deliberately avoids spelling out the script element's
 * tag name in angle brackets — even inside a comment, that substring can
 * desync Vite's lightweight dependency-scan parser for .astro frontmatter
 * and produce a confusing "Expected ';'" error in dev mode only, never in a
 * production build.)
 */
import { t } from "@/i18n";
import { DEFAULT_LOCALE } from "@/lib/locale";

const locale = DEFAULT_LOCALE;

const localeActiveClasses = "bg-white text-navy-deep shadow-sm";
// text-ice/70 has the same broken-opacity-modifier problem as the header
// background (see file comment) — plain text-ice reads close enough to it
// (ice is already an off-white, subdued next to the solid-white active
// pill) without relying on a modifier that silently drops to transparent.
const localeInactiveClasses = "text-ice hover:text-white";
---

<header class="sticky top-0 z-40 border-b border-[var(--border-on-dark)] bg-[var(--nav-bg)] text-white backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3 sm:px-8">
    <a href="/" class="flex items-baseline gap-1.5 font-display font-extrabold tracking-tight">
      <span class="text-white">CV</span>
      <span class="text-orange">Maker</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      <a href="/" data-i18n="nav.home" class="text-sm font-medium opacity-80 transition-opacity hover:opacity-100">
        {t(locale, "nav.home")}
      </a>
      <a
        href="/pricing"
        data-i18n="nav.pricing"
        class="text-sm font-medium opacity-80 transition-opacity hover:opacity-100"
      >
        {t(locale, "nav.pricing")}
      </a>
      <a
        href="/dashboard"
        data-i18n="nav.dashboard"
        class="text-sm font-medium opacity-80 transition-opacity hover:opacity-100"
      >
        {t(locale, "nav.dashboard")}
      </a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      {/* Both languages shown side by side, the active one visibly filled in
       * — not a single button labeled with whatever you'd switch *to* (the
       * earlier implementation), which reads as "what does this do?" rather
       * than "what language am I in?" at a glance. Same pattern as the CV
       * content-language picker on the Personal Info step, so the "this
       * toggles a language, pick either side" language is consistent
       * app-wide. Astro renders `en` active by default (DEFAULT_LOCALE); the
       * script below corrects it client-side if a stored `pt-PT` preference
       * exists, same indirection LocaleHydration.astro uses for text. */}
      <div
        id="locale-switch"
        role="radiogroup"
        aria-label="Switch language"
        data-active-classes={localeActiveClasses}
        data-inactive-classes={localeInactiveClasses}
        class="inline-flex rounded-md border border-[var(--border-on-dark)] bg-[var(--nav-pill-bg)] p-0.5"
      >
        <button
          type="button"
          data-locale-option="en"
          role="radio"
          aria-checked="true"
          class:list={["locale-switch-option mono-label rounded-[5px] px-2.5 py-1 text-[11px] transition-colors duration-fast ease-standard", localeActiveClasses]}
        >
          EN
        </button>
        <button
          type="button"
          data-locale-option="pt-PT"
          role="radio"
          aria-checked="false"
          class:list={["locale-switch-option mono-label rounded-[5px] px-2.5 py-1 text-[11px] transition-colors duration-fast ease-standard", localeInactiveClasses]}
        >
          PT
        </button>
      </div>
      <span id="nav-guest" class="flex items-center gap-2 sm:gap-3">
        <a href="/login" data-i18n="nav.login" class="hidden text-sm font-medium text-ice hover:text-white sm:inline">
          {t(locale, "nav.login")}
        </a>
        <a
          href="/signup"
          data-i18n="nav.startFree"
          class="inline-flex items-center rounded-md bg-orange px-3.5 py-2 text-sm font-semibold text-white transition-colors duration-fast ease-standard hover:bg-accent-hover"
        >
          {t(locale, "nav.startFree")}
        </a>
      </span>
      <span id="nav-authed" class="hidden items-center gap-2 sm:gap-3">
        <a
          href="/dashboard"
          data-i18n="nav.dashboard"
          class="hidden text-sm font-medium text-ice hover:text-white sm:inline"
        >
          {t(locale, "nav.dashboard")}
        </a>
        <button
          type="button"
          id="nav-logout"
          data-i18n="nav.logout"
          class="inline-flex items-center rounded-md border border-[var(--border-on-dark)] px-3.5 py-2 text-sm font-semibold text-ice transition-colors duration-fast ease-standard hover:bg-navy-mid"
        >
          {t(locale, "nav.logout")}
        </button>
      </span>
    </div>
  </div>
</header>

<script>
  import { getStoredLocale, setStoredLocale } from "@/lib/locale";
  import { refreshSession } from "@/lib/api-client";
  import { logOut, updateLocale } from "@/domains/auth/api";
  import type { BuilderLocale } from "@cv-maker/contracts";

  const localeSwitch = document.getElementById("locale-switch");
  const activeClasses = (localeSwitch?.dataset.activeClasses ?? "").split(" ").filter(Boolean);
  const inactiveClasses = (localeSwitch?.dataset.inactiveClasses ?? "").split(" ").filter(Boolean);

  function paintLocaleSwitch(current: BuilderLocale) {
    localeSwitch?.querySelectorAll<HTMLButtonElement>("[data-locale-option]").forEach((btn) => {
      const isActive = btn.dataset.localeOption === current;
      btn.classList.remove(...activeClasses, ...inactiveClasses);
      btn.classList.add(...(isActive ? activeClasses : inactiveClasses));
      btn.setAttribute("aria-checked", String(isActive));
    });
  }

  // Astro renders the "en" option active by default (DEFAULT_LOCALE) since
  // there's no per-request server to pick a locale before render — correct
  // it here the same way LocaleHydration.astro corrects text nodes.
  paintLocaleSwitch(getStoredLocale());

  // Nav is otherwise static Astro markup with no per-request auth context
  // (see the file-level comment) — this is the one place it needs to know
  // whether the visitor is signed in, so it silently tries to derive a
  // session from the httpOnly refresh cookie on every page load and swaps
  // the guest/authed button groups accordingly. Failure just means "signed
  // out," not an error — swallowed on purpose. The locale-switch handler
  // below also needs this to decide whether to persist onto `user.locale`.
  const guestGroup = document.getElementById("nav-guest");
  const authedGroup = document.getElementById("nav-authed");
  let signedIn = false;
  refreshSession()
    .then((session) => {
      if (!session) return;
      signedIn = true;
      guestGroup?.classList.add("hidden");
      authedGroup?.classList.remove("hidden");
      authedGroup?.classList.add("flex");
    })
    .catch(() => {
      /* not signed in — guest nav (the default) is already showing */
    });

  localeSwitch?.addEventListener("click", (e) => {
    const button = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-locale-option]");
    const next = button?.dataset.localeOption;
    if (next !== "en" && next !== "pt-PT") return;
    // Best-effort: also persist onto `user.locale` server-side when signed
    // in, so cv-optimizer's report/rewrite language follows this same
    // switch (see AccountPage.tsx's LocaleSwitch, which does the same).
    if (signedIn) updateLocale(next).catch((err) => console.error("Failed to persist account locale", err));
    setStoredLocale(next);
    window.location.reload();
  });

  document.getElementById("nav-logout")?.addEventListener("click", async () => {
    await logOut();
    window.location.href = "/";
  });
</script>
