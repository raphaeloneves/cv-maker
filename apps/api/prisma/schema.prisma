// CV Maker — database schema.
// All changes to this file MUST ship as a Prisma migration
// (`pnpm --filter @cv-maker/api prisma migrate dev` locally,
// `prisma migrate deploy` on container startup) — never applied by hand
// against a running database. See /Users/rneves/.claude/plans/calm-enchanting-wilkes.md.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & billing
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  // Account identity — distinct from PersonalInfo.firstName/lastName, which
  // is per-CV content (features/19's same "account vs CV content" split as
  // email). Backfilled empty for pre-existing rows (see the migration and
  // prisma/seed.ts); the UI falls back to email wherever this is blank.
  firstName    String   @default("")
  lastName     String   @default("")
  // Intentionally decoupled from PersonalInfo.email — see features/19.
  email        String   @unique
  passwordHash String
  locale       BuilderLocale @default(PT_PT)
  // ADMIN bypasses all paywall/entitlement checks (see
  // @cv-maker/contracts billing.ts:hasActiveEntitlement) — internal
  // QA/demo accounts only, seeded via prisma/seed.ts, never self-serve.
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cvs                    Cv[]
  subscription           Subscription?
  termsAcceptances       TermsAcceptance[]
  refreshTokens          RefreshToken[]
  cvOptimizerReports     CvOptimizerReport[]
  academyLessonProgress  AcademyLessonProgress[]

  @@map("users")
}

// Audit trail for terms acceptance, recorded regardless of the UI consent
// pattern chosen — see features/16's flag that implicit consent needs
// LGPD/legal review before reuse as-is.
model TermsAcceptance {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  acceptedAt DateTime @default(now())

  @@map("terms_acceptances")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@map("refresh_tokens")
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  CANCELED
  PAST_DUE
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               SubscriptionStatus @default(NONE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// CV shell
// ---------------------------------------------------------------------------

enum BuilderLocale {
  PT_PT
  EN
}

enum CvContentLanguage {
  PT_PT
  EN
}

enum TemplateId {
  HELSINKI
  LISBON
  KYOTO
  DENVER
  MARRAKECH
  GENEVA
  PORTO
  FARO
}

model Cv {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String            @default("Untitled CV")
  contentLanguage CvContentLanguage @default(PT_PT)
  templateId      TemplateId        @default(HELSINKI)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  personalInfo         PersonalInfo?
  sections             Section[]
  templatePreferences  CvTemplatePreference[]
  // onDelete: SetNull, not Cascade — a report is a standalone record of a
  // past analysis; deleting the CV it was run against shouldn't destroy it.
  cvOptimizerReports   CvOptimizerReport[]
  // Back-relation for CvOptimizerReport.rewriteCvId — the CV(s), if any,
  // generated *from* a report's "improved CV" action (as opposed to the CV
  // a report was originally run against, above).
  rewrittenFromReports CvOptimizerReport[] @relation("CvOptimizerReportRewriteCv")

  @@map("cvs")
}

model CvTemplatePreference {
  id         String     @id @default(uuid())
  cvId       String
  cv         Cv         @relation(fields: [cvId], references: [id], onDelete: Cascade)
  templateId TemplateId
  color      String

  @@unique([cvId, templateId])
  @@map("cv_template_preferences")
}

// ---------------------------------------------------------------------------
// Personal info (features/01, 02)
// ---------------------------------------------------------------------------

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  SELF_DESCRIBED
  PREFER_NOT_TO_SAY
}

model PersonalInfo {
  id                 String   @id @default(uuid())
  cvId               String   @unique
  cv                 Cv       @relation(fields: [cvId], references: [id], onDelete: Cascade)

  firstName          String
  lastName           String
  email              String
  address            String?
  phone              String?
  postalCode         String?
  city               String?

  dobDay             Int?
  dobMonth           Int?
  dobYear            Int?
  placeOfBirth       String?
  drivingLicence     String?
  gender             Gender?
  genderSelfDescribed String?
  nationality        String?
  maritalStatus      String?
  linkedin           String?
  website            String?

  photoUrl           String?
  photoZoom          Float?
  photoRotationDeg   Int?

  updatedAt          DateTime @updatedAt

  @@map("personal_info")
}

// ---------------------------------------------------------------------------
// Sections (features/14, 15) — one generic Section row per section instance,
// plus one child entry table per structured type. Freeform sections
// (profile_summary/achievements/publications/custom) store their body
// directly on the Section row.
// ---------------------------------------------------------------------------

enum SectionType {
  PROFILE_SUMMARY
  WORK_EXPERIENCE
  EDUCATION
  SKILLS
  HOBBIES
  REFERENCES
  LANGUAGES
  COURSES
  ACHIEVEMENTS
  PUBLICATIONS
  CUSTOM
}

model Section {
  id                      String      @id @default(uuid())
  cvId                    String
  cv                      Cv          @relation(fields: [cvId], references: [id], onDelete: Cascade)
  type                    SectionType
  displayName             String?
  sortOrder               Float
  hidden                  Boolean     @default(false)
  forcePageBreak          Boolean     @default(false)
  organizeChronologically Boolean     @default(false)
  deletable               Boolean     @default(true)
  // References' showAvailableUponRequest and any other section-type-specific
  // toggle that doesn't warrant its own column (features/10, 15).
  settings                Json        @default("{}")
  // Body for profile_summary / achievements / publications / custom only.
  freeformDescription     String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  workExperienceEntries WorkExperienceEntry[]
  educationEntries      EducationEntry[]
  courseEntries         CourseEntry[]
  skillEntries          SkillEntry[]
  languageEntries       LanguageEntry[]
  hobbyEntries          HobbyEntry[]
  referenceEntries      ReferenceEntry[]

  @@index([cvId])
  @@map("sections")
}

// Idempotency ledger for section creation — a (cvId, clientRequestId) hit
// returns the original section instead of creating a duplicate. Direct fix
// for the reference product's confirmed duplicate-section-on-rapid-input bug
// (features/14, 15).
model SectionCreationRequest {
  id              String   @id @default(uuid())
  cvId            String
  clientRequestId String
  sectionId       String
  createdAt       DateTime @default(now())

  @@unique([cvId, clientRequestId])
  @@map("section_creation_requests")
}

enum DateGranularity {
  FULL
  YEAR_ONLY
  HIDDEN
}

// Shared shape (documented once, applied via @@map per model) for the three
// "repeatable timeline entry" sections — features/05, 06, 11.

model WorkExperienceEntry {
  id              String          @id @default(uuid())
  sectionId       String
  section         Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title           String
  employer        String
  city            String?
  startGranularity DateGranularity
  startMonth      Int?
  startYear       Int
  endIsPresent    Boolean
  endGranularity  DateGranularity?
  endMonth        Int?
  endYear         Int?
  description     String?
  sortOrder       Float
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([sectionId])
  @@map("work_experience_entries")
}

model EducationEntry {
  id              String          @id @default(uuid())
  sectionId       String
  section         Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  degree          String
  school          String
  city            String?
  startGranularity DateGranularity
  startMonth      Int?
  startYear       Int
  endIsPresent    Boolean
  endGranularity  DateGranularity?
  endMonth        Int?
  endYear         Int?
  description     String?
  sortOrder       Float
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([sectionId])
  @@map("education_entries")
}

model CourseEntry {
  id              String          @id @default(uuid())
  sectionId       String
  section         Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  courseName      String
  institution     String
  credentialUrl   String?
  city            String?
  startGranularity DateGranularity
  startMonth      Int?
  startYear       Int
  endIsPresent    Boolean
  endGranularity  DateGranularity?
  endMonth        Int?
  endYear         Int?
  description     String?
  sortOrder       Float
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([sectionId])
  @@map("course_entries")
}

model SkillEntry {
  id        String   @id @default(uuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name      String
  // Evenly-spaced 1-5 rank — fixes the reference product's uneven scale
  // (features/07).
  level     Int
  sortOrder Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@map("skill_entries")
}

enum LanguageScale {
  DESCRIPTIVE
  CEFR
}

model LanguageEntry {
  id           String        @id @default(uuid())
  sectionId    String
  section      Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  languageName String
  scale        LanguageScale
  // Stores the enum value string from the matching scale ('native' | ... |
  // 'A1' | ... ) — the scale discriminant lives in `scale`, never inferred
  // from this value (features/08).
  level        String
  sortOrder    Float
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([sectionId])
  @@map("language_entries")
}

model HobbyEntry {
  id        String   @id @default(uuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@map("hobby_entries")
}

model ReferenceEntry {
  id            String   @id @default(uuid())
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  companyName   String
  contactPerson String
  phone         String?
  email         String?
  sortOrder     Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sectionId])
  @@map("reference_entries")
}

// ---------------------------------------------------------------------------
// CV Optimizer (Pro feature) — see @cv-maker/contracts cv-optimizer.ts
// ---------------------------------------------------------------------------

enum CvOptimizerReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Deliberately one flat model, not the polymorphic multi-insight-type table
// this was ported from — this app only ever generates one kind of report,
// and there's no credit ledger to join against (gating is the same
// `hasActiveEntitlement()` check as watermark/premium-template access, not a
// balance). Generation runs as a single Claude call kicked off right after
// create; status/errorMessage/reportContent track that one call's lifecycle.
model CvOptimizerReport {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable + SetNull (not Cascade, see Cv's own comment): the report should
  // outlive the CV it was originally run against.
  cvId   String?
  cv     Cv?     @relation(fields: [cvId], references: [id], onDelete: SetNull)
  // Set instead of cvId when the user uploaded a CV as a PDF rather than
  // picking one of their own CVs — uploadedCvText is the plain text
  // extracted from it (same "resolve to text before storage" rule as
  // jobDescription below), kept for provenance/debugging, not re-read at
  // generation time (that gets it as a function argument instead).
  uploadedCvFileName String?
  uploadedCvText     String? @db.Text

  roleTitle         String
  // Always resolved to plain text before storage — either pasted directly,
  // or fetched server-side from jobDescriptionUrl and stripped to text. The
  // Claude call itself only ever sees this field, never fetches anything.
  jobDescription    String   @db.Text
  jobDescriptionUrl String?
  status            CvOptimizerReportStatus @default(PENDING)
  errorMessage       String?
  // The full structured Claude response once status = COMPLETED — see
  // cvOptimizerReportContentSchema in contracts for the shape.
  reportContent      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // "Generate an improved CV" — a second, on-demand Claude call scoped to
  // this same report (only offered once objectionsScorePercent > 50; see
  // service.ts's requireRewriteEligible). Same 4-state lifecycle as the
  // report itself, reusing CvOptimizerReportStatus rather than a second
  // enum. A named relation since this is CvOptimizerReport's *second* FK
  // onto Cv (the first being cvId above) — Prisma needs the two
  // disambiguated. onDelete: SetNull for the same reason as cvId: deleting
  // the generated CV later shouldn't destroy the report recording that it
  // happened.
  rewriteStatus       CvOptimizerReportStatus?
  rewriteCvId         String?
  rewriteCv           Cv?                      @relation("CvOptimizerReportRewriteCv", fields: [rewriteCvId], references: [id], onDelete: SetNull)
  rewriteErrorMessage String?

  @@index([userId])
  @@map("cv_optimizer_reports")
}

// ---------------------------------------------------------------------------
// Academy (post-auth learning section) — module/lesson definitions and their
// body copy are static content in apps/api/src/modules/academy/content.ts
// (editorial content edited in code, not a DB table, same reasoning as
// TemplateId), so the only thing persisted here is per-user completion.
// Gating (which lessons are free vs. require an active entitlement) is
// computed at request time from that same content.ts + hasActiveEntitlement,
// never stored.
// ---------------------------------------------------------------------------

model AcademyLessonProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Slug from content.ts's lesson registry — not a FK, since lessons aren't
  // a DB table.
  lessonSlug  String
  completedAt DateTime @default(now())

  @@unique([userId, lessonSlug])
  @@map("academy_lesson_progress")
}
