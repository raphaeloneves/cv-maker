{
  "name": "cv-maker",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "build": "pnpm --recursive --filter ./packages/* run build && pnpm --recursive --filter ./apps/* run build",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "docker:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "docker:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
