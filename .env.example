# Copy to .env (repo root, used by docker-compose) and fill in real values.
# Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=cvmaker
POSTGRES_PASSWORD=cvmaker_dev_password
POSTGRES_DB=cvmaker
DATABASE_URL=postgresql://cvmaker:cvmaker_dev_password@postgres:5432/cvmaker?schema=public

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Object storage (MinIO locally, S3/R2-compatible in production) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=cv-maker-photos
S3_ACCESS_KEY_ID=cvmaker
S3_SECRET_ACCESS_KEY=cvmaker_dev_secret
S3_FORCE_PATH_STYLE=true
# Public base URL used to build photoUrl values returned to the client.
S3_PUBLIC_BASE_URL=http://localhost:9000/cv-maker-photos

# --- Stripe (test mode) — you must supply your own test-mode keys ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me

# --- Claude API (CV Optimizer, Pro feature) — you must supply your own key ---
ANTHROPIC_API_KEY=sk-ant-replace_me

# --- App ---
API_PORT=4000
WEB_ORIGIN=http://localhost:4321
NODE_ENV=development

# --- Seeded admin/QA account (role=ADMIN, bypasses paywall + watermark
# entirely — see hasActiveEntitlement in packages/contracts/src/billing.ts).
# Change the password before deploying anywhere reachable by the public. ---
SEED_ADMIN_EMAIL=admin@cvmaker.dev
SEED_ADMIN_PASSWORD=change-me-before-deploy-1234
